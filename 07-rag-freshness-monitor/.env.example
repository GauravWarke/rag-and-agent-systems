# Copy to .env and fill in. .env is gitignored — never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO

# Corpus and index locations
DOCS_DIR=data/docs
DOCS_META_PATH=data/docs_meta.json
MANIFEST_PATH=data/index/manifest.json
PROBES_PATH=data/probes.json

# Embeddings (offline "stub" by default; no API key required)
EMBEDDING_MODEL=stub
EMBEDDING_VERSION=stub-v1
CHUNKING_STRATEGY=heading

# Below this semantic change score, a modified section is treated as a
# cosmetic/typo edit rather than a meaningful content change.
SEMANTIC_CHANGE_EPSILON=0.02

# Rate limiting (requests per minute per client) for public endpoints
RATE_LIMIT_PER_MINUTE=60
