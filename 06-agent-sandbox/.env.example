# Copy to .env and fill in. .env is gitignored — never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO

# Planner provider key (leave blank to use the offline "stub" keyword planner only)
OPENAI_API_KEY=

# Rate limiting (requests per minute per client) for public endpoints
RATE_LIMIT_PER_MINUTE=60

# Sandbox folder the file_reader tool is allowed to read from (relative to
# the project root unless given as an absolute path)
SANDBOX_DIR=sandbox_files
