# Copy to .env and fill in. .env is gitignored — never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO

# LLM provider keys (leave blank to use the offline "stub" provider only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=false

# Config data files
MODEL_REGISTRY_PATH=data/model_registry.yaml
BUDGET_POLICIES_PATH=data/budget_policies.yaml
ROUTING_OVERRIDES_PATH=data/routing_overrides.yaml

# Budget enforcement
BUDGET_WARNING_THRESHOLD_PCT=80.0

# Rate limiting (requests per minute per client) for the public /v1/chat endpoint
RATE_LIMIT_PER_MINUTE=60

# Quality verification and escalation
QUALITY_SAMPLE_RATE=0.2
QUALITY_SIMILARITY_THRESHOLD=0.5
ESCALATION_MIN_SAMPLES=5
ESCALATION_MISS_RATE_THRESHOLD=0.3
