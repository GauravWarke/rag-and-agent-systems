# Copy to .env and fill in. .env is gitignored — never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO

# Rate limiting (requests per minute per client) for public endpoints
RATE_LIMIT_PER_MINUTE=60

# OCR engine: "auto" uses pytesseract when the tesseract binary is on PATH,
# else falls back to the offline "stub" engine. Force "stub" for
# deterministic offline demos/tests, or "tesseract" to require it.
OCR_ENGINE=auto
OCR_CONFIDENCE_THRESHOLD=0.6

# Vision fallback provider key (leave blank to use the offline stub, which
# flags low-confidence pages for manual review instead of guessing)
VISION_API_KEY=

# Minimum acceptable normalized page resolution before flagging a warning
MIN_PAGE_WIDTH_PX=600
MIN_PAGE_HEIGHT_PX=600
