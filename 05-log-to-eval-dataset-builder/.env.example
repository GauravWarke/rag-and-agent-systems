# Copy to .env and fill in. .env is gitignored — never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO

# Label-generation provider key (leave blank to use the offline "stub" label client only)
OPENAI_API_KEY=

# Rate limiting (requests per minute per client) for public endpoints
RATE_LIMIT_PER_MINUTE=60

# Similarity threshold above which a candidate eval case is treated as a
# near-duplicate of one already in the dataset (0-1, cosine similarity)
DEDUPE_SIMILARITY_THRESHOLD=0.92
