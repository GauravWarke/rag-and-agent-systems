# Copy to .env and fill in. .env is gitignored — never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO

# LLM provider keys (leave blank to use the offline rule-based stub generator)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Prompt under test
BASELINE_PROMPT=crm_summary_v1
CANDIDATE_PROMPT=crm_summary_v2
GENERATION_MODEL=stub           # stub | gpt-4o-mini | claude-haiku

# Release gate thresholds
SCHEMA_VALIDITY_DROP_BLOCK_PCT=2.0
COST_INCREASE_BLOCK_PCT=20.0
LATENCY_INCREASE_WARN_PCT=20.0

# Rate limiting (requests per minute per client) for the public /summarize endpoint
RATE_LIMIT_PER_MINUTE=60
