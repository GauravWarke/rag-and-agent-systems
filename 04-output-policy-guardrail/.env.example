# Copy to .env and fill in. .env is gitignored — never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO

# LLM judge provider key (leave blank to use the offline "stub" judge only)
OPENAI_API_KEY=

# Config data files
POLICIES_PATH=data/policies.yaml
FORBIDDEN_TERMS_PATH=data/forbidden_terms.yaml

# Rate limiting (requests per minute per client) for the public /v1/review endpoint
RATE_LIMIT_PER_MINUTE=60
