# Copy to .env and fill in. .env is gitignored — never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO

# LLM / embeddings provider keys (leave blank to use the local hashing-embedding stub)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval config
EMBEDDING_MODEL=stub            # stub | text-embedding-3-small | bge-small
VECTOR_STORE=memory             # memory | chroma | qdrant
DENSE_TOP_K=20
SPARSE_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# Confidence thresholds
MIN_RETRIEVAL_SCORE=0.15
